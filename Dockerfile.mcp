FROM python:3.11-slim-trixie

COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_NO_CACHE=1 \
    UV_LINK_MODE=copy \
    PYTHONPATH="/MoneyPrinterTurbo"

WORKDIR /MoneyPrinterTurbo

RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg && \
    rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
RUN python3 -c "import tomllib, pathlib; d = tomllib.loads(pathlib.Path('pyproject.toml').read_text()); deps = [x for x in d['project']['dependencies'] if not x.startswith(('streamlit', 'audioop-lts'))] + ['toml']; pathlib.Path('/tmp/req-mcp.txt').write_text('\n'.join(deps) + '\n')" && \
    uv pip install --system -r /tmp/req-mcp.txt && \
    rm -f /tmp/req-mcp.txt

COPY app ./app
COPY mcp_server.py ./
COPY config.example.toml ./config.toml
RUN python3 -c "import app.mcp.server as s; print('verified tools:', len(s.mcp._tool_manager._tools))" && \
    rm -f /MoneyPrinterTurbo/config.toml

ENTRYPOINT ["python3", "/MoneyPrinterTurbo/mcp_server.py"]
